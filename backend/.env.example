# Environment Configuration for Legal Awareness App Backend

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Alternative LLM configurations (for future use)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Application Settings
ENV=development
DEBUG=True

# CORS Settings (add your frontend URLs)
ALLOWED_ORIGINS=http://localhost:8081,http://10.0.2.2:8081,exp://localhost:8081

# File Upload Settings
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=png,jpg,jpeg,tiff,bmp

# OCR Settings
OCR_LANGUAGE=eng
OCR_DPI=300

# Instructions:
# 1. Copy this file to .env
# 2. Replace 'your_gemini_api_key_here' with your actual Google Gemini API key
# 3. Get your API key from: https://makersuite.google.com/app/apikey
# 4. Never commit the .env file to version control
# Last updated: Ready for LLM integration testing
